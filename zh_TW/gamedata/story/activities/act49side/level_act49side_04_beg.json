 "attributes": {"time": 0.5}}, {"id": 55, "prop": "charslot", "attributes": {"slot": "r", "focus": "r"}}, {"id": 56, "prop": "name", "attributes": {"content": "妖言惑眾！", "name": "大炎邊軍"}, "figure_art": "avg_npc_2133_1#1$1"}, {"id": 57, "prop": "dialog", "attributes": {}}, {"id": 58, "prop": "charslot", "attributes": {"slot": "m", "action": "shake", "power": 5.0, "times": 30.0, "duration": 0.6, "block": "true"}}, {"id": 59, "prop": "charslot", "attributes": {"slot": "m", "posfrom": "-300,-50", "posto": "-300,0", "duration": 0.6}}, {"id": 60, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 61, "prop": "charslot", "attributes": {"slot": "m", "focus": "m"}}, {"id": 62, "prop": "name", "attributes": {"content": "呼、呼……", "name": "決絕的山海眾成員"}}, {"id": 63, "prop": "charslot", "attributes": {"slot": "r", "focus": "r"}}, {"id": 64, "prop": "name", "attributes": {"content": "放下武器，還能饒你不死！", "name": "大炎邊軍"}}, {"id": 65, "prop": "charslot", "attributes": {"slot": "m", "focus": "m"}}, {"id": 66, "prop": "name", "attributes": {"content": "放下武器？", "name": "決絕的山海眾成員"}}, {"id": 67, "prop": "name", "attributes": {"content": "我們就是要讓炎氏一脈知道，矩獸已醒，他自以為可以千秋萬代的江山，和這無限天地相比，終究不過黃粱一夢！", "name": "決絕的山海眾成員"}}, {"id": 68, "prop": "name", "attributes": {"content": "山海八荒，盡歸——", "name": "決絕的山海眾成員"}}, {"id": 69, "prop": "dialog", "attributes": {}}, {"id": 70, "prop": "playsound", "attributes": {"key": "$d_avg_knife", "channel": "1"}}, {"id": 71, "prop": "charslot", "attributes": {"slot": "r", "posfrom": "100,0", "posto": "-300,0", "duration": 0.3}}, {"id": 72, "prop": "playsound", "attributes": {"key": "$d_avg_spear"}}, {"id": 73, "prop": "Blocker", "attributes": {"a": 0.2, "r": 1.0, "g": 0.0, "b": 0.0, "fadetime": 0.2, "block": "true"}}, {"id": 74, "prop": "charslot", "attributes": {"slot": "m", "posfrom": "-300,0", "posto": "-380,0", "duration": 0.5}}, {"id": 75, "prop": "charslot", "attributes": {"slot": "m", "action": "shake", "power": 5.0, "times": 50.0, "duration": 0.5, "block": "true"}}, {"id": 76, "prop": "Dialog", "attributes": {}}, {"id": 77, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 78, "prop": "StopSound", "attributes": {"channel": "bgs", "fadetime": 2.0}}, {"id": 79, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 80, "prop": "charslot", "attributes": {}}, {"id": 81, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 82, "prop": "playsound", "attributes": {"key": "$d_avg_crwddiscuss_inside", "loop": "true", "channel": "bgs", "volume": 0.0}}, {"id": 83, "prop": "SoundVolume", "attributes": {"volume": 0.5, "channel": "bgs", "fadetime": 2.0}}, {"id": 84, "prop": "Background", "attributes": {"image": "35_g7_zuosroom", "screenadapt": "coverall"}}, {"id": 85, "prop": "playMusic", "attributes": {"key": "$m_avg_yumennormal_loop", "volume": 0.6}}, {"id": 86, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 87, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 88, "prop": "playsound", "attributes": {"key": "$d_avg_plateplace"}}, {"id": 89, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 90, "prop": "name", "attributes": {"content": "來，喝！", "name": "略帶酒意的欽差"}}, {"id": 91, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2133_1#1$1"}}, {"id": 92, "prop": "name", "attributes": {"content": "怎麼敢讓大人為我斟酒——", "name": "受寵若驚的士兵"}, "figure_art": "avg_npc_2133_1#1$1"}, {"id": 93, "prop": "charslot", "attributes": {"slot": "m", "focus": "n"}}, {"id": 94, "prop": "name", "attributes": {"content": "切不可妄自菲薄！", "name": "略帶酒意的欽差"}}, {"id": 95, "prop": "name", "attributes": {"content": "時隔數百年，我輩終於誅殺了那場狩獵最後的遺害，經此一役，大炎疆域徹底無憂矣！", "name": "略帶酒意的欽差"}}, {"id": 96, "prop": "name", "attributes": {"content": "這一杯酒，我敬諸位！", "name": "略帶酒意的欽差"}}, {"id": 97, "prop": "Dialog", "attributes": {}}, {"id": 98, "prop": "charslot", "attributes": {"slot": "m", "focus": "all"}}, {"id": 99, "prop": "playsound", "attributes": {"key": "$pourwater"}}, {"id": 100, "prop": "delay", "attributes": {"time": 1.5}}, {"id": 101, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2133_1#1$1"}}, {"id": 102, "prop": "name", "attributes": {"content": "謝大人賜酒！", "name": "受寵若驚的士兵"}, "figure_art": "avg_npc_2133_1#1$1"}, {"id": 103, "prop": "Dialog", "attributes": {}}, {"id": 104, "prop": "charslot", "attributes": {"duration": 1.0}}, {"id": 105, "prop": "delay", "attributes": {"time": 2.0}}, {"id": 106, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2024_chyue_1#1$1", "duration": 1.0}}, {"id": 107, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2", "duration": 1.0}}, {"id": 108, "prop": "delay", "attributes": {"time": 2.0}}, {"id": 109, "prop": "charslot", "attributes": {"slot": "m", "focus": "n"}}, {"id": 110, "prop": "name", "attributes": {"content": "當然，還有兩位先生。", "name": "略帶酒意的欽差"}}, {"id": 111, "prop": "name", "attributes": {"content": "朔先生身先士卒以一當千，大振軍心；望先生排兵布陣更是算無遺策。 ", "name": "略帶酒意的欽差"}}, {"id": 112, "prop": "name", "attributes": {"content": "今日誅殺矩獸，二位先生才當居首功。", "name": "略帶酒意的欽差"}}, {"id": 113, "prop": "name", "attributes": {"content": "這一杯酒，我敬兩位。", "name": "略帶酒意的欽差"}}, {"id": 114, "prop": "Dialog", "attributes": {}}, {"id": 115, "prop": "charslot", "attributes": {"slot": "m", "focus": "all"}}, {"id": 116, "prop": "playsound", "attributes": {"key": "$d_avg_plateplace"}}, {"id": 117, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 118, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2024_chyue_1#1$1", "focus": "r"}}, {"id": 119, "prop": "name", "attributes": {"content": "……多謝。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 120, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2", "focus": "l"}}, {"id": 121, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 122, "prop": "charslot", "attributes": {"slot": "m", "focus": "n"}}, {"id": 123, "prop": "name", "attributes": {"content": "望先生，機會難得，有些話我須得直言。", "name": "略帶酒意的欽差"}}, {"id": 124, "prop": "name", "attributes": {"content": "我很清楚，朝中曾有不少對先生的流言中傷。大多是質疑先生非我族類，心有不軌。", "name": "略帶酒意的欽差"}}, {"id": 125, "prop": "name", "attributes": {"content": "但先生卻是安耐毀譽，為大炎立下不世之功。如此高風亮節，著實令人敬佩。", "name": "略帶酒意的欽差"}}, {"id": 126, "prop": "name", "attributes": {"content": "我知道，如今司歲台對各位的限制的確不能說鬆懈，甚至連你們手足團聚也要干涉，未免不近人情。", "name": "略帶酒意的欽差"}}, {"id": 127, "prop": "name", "attributes": {"content": "我這次回去，一定請奏陛下，特准諸位闔家歡聚……", "name": "略帶酒意的欽差"}}, {"id": 128, "prop": "Dialog", "attributes": {}}, {"id": 129, "prop": "StopSound", "attributes": {"channel": "bgs", "fadetime": 2.0}}, {"id": 130, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 131, "prop": "charslot", "attributes": {}}, {"id": 132, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 133, "prop": "Background", "attributes": {"image": "70_g11_oldpavilion", "screenadapt": "coverall"}}, {"id": 134, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 135, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 136, "prop": "name", "attributes": {"content": "今天確實高興，我自覺酒量不錯，也已經不勝酒力了……", "name": "酩酊大醉的欽差"}}, {"id": 137, "prop": "name", "attributes": {"content": "說實話，出征之前，上面是吩咐過，讓我……看著兩位，別出什麼問題。", "name": "酩酊大醉的欽差"}}, {"id": 138, "prop": "name", "attributes": {"content": "但今天一戰下來，兩位都……證明了自己，忠心不二，令人……敬佩！", "name": "酩酊大醉的欽差"}}, {"id": 139, "prop": "name", "attributes": {"content": "那就……送兩位到這裡了！兩位……保重！", "name": "酩酊大醉的欽差"}}, {"id": 140, "prop": "dialog", "attributes": {}}, {"id": 141, "prop": "playsound", "attributes": {"key": "$d_avg_armywalking", "loop": "true", "channel": "a"}}, {"id": 142, "prop": "StopSound", "attributes": {"channel": "a", "fadetime": 3.0}}, {"id": 143, "prop": "delay", "attributes": {"time": 1.5}}, {"id": 144, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 145, "prop": "name", "attributes": {"content": "醉眼乜斜的官員捋直舌頭，跟兩人告了別，在衛兵的簇擁下漸漸走遠。"}}, {"id": 146, "prop": "dialog", "attributes": {}}, {"id": 147, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#1$1", "duration": 1.0}}, {"id": 148, "prop": "delay", "attributes": {"time": 1.5}}, {"id": 149, "prop": "name", "attributes": {"content": "……他是個好人，也是個不稱職的探子。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 150, "prop": "name", "attributes": {"content": "你有沒有想過，如果他察覺了你做的事，我們一家會面對什麼樣的麻煩？", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 151, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 152, "prop": "name", "attributes": {"content": "大哥醉了。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 153, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#1$1"}}, {"id": 154, "prop": "name", "attributes": {"content": "我倒希望我看到的，只是我醉後的一場夢。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 155, "prop": "playMusic", "attributes": {"key": "$darkness_03_loop", "volume": 0.6}}, {"id": 156, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 157, "prop": "name", "attributes": {"content": "……你究竟為什麼要私自放走矩獸？", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 158, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 159, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 160, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#3$2"}}, {"id": 161, "prop": "name", "attributes": {"content": "留一手伏兵，好過毫無底牌。", "name": "望"}, "figure_art": "avg_2027_wang_1#3$2"}, {"id": 162, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 163, "prop": "name", "attributes": {"content": "這一次，你又是在與誰爭勝？", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 164, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 165, "prop": "name", "attributes": {"content": "你一定感覺得到，我們所有人都能感覺到……祂正在醒來，祂甦醒的速度，比預測的千年更快，快得多。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 166, "prop": "name", "attributes": {"content": "我們必須要找到別的助力。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 167, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#6$1"}}, {"id": 168, "prop": "name", "attributes": {"content": "是矩獸同意幫你除歲？", "name": "朔"}, "figure_art": "avg_2024_chyue_1#6$1"}, {"id": 169, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 170, "prop": "name", "attributes": {"content": "祂太過虛弱，連山海眾都無力庇護，我們也並未聊到這一步。時候未到。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 171, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 172, "prop": "name", "attributes": {"content": "我與你說過，想要擺脫祂的影響，明明還有其他手段——", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 173, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 174, "prop": "name", "attributes": {"content": "我知道你要說什麼。你終於理清了你自己和祂之間的糾纏，你也想讓“我”不再是“我們”，而“我們”也不再是“祂”……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 175, "prop": "name", "attributes": {"content": "於是你把“自己”封在了那柄劍裡，了不起……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 176, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#3$2"}}, {"id": 177, "prop": "name", "attributes": {"content": "然後又當如何？呵，司歲台把劍還你了嗎？", "name": "望"}, "figure_art": "avg_2027_wang_1#3$2"}, {"id": 178, "prop": "name", "attributes": {"content": "我們還是要活在這一層桎梏當中……", "name": "望"}, "figure_art": "avg_2027_wang_1#3$2"}, {"id": 179, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 180, "prop": "name", "attributes": {"content": "桎梏不在外物——", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 181, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#11$2"}}, {"id": 182, "prop": "name", "attributes": {"content": "你真的相信，所有人都能達到像你這樣的境界？", "name": "望"}, "figure_art": "avg_2027_wang_1#11$2"}, {"id": 183, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#9$1"}}, {"id": 184, "prop": "name", "attributes": {"content": "……", "name": "朔"}, "figure_art": "avg_2024_chyue_1#9$1"}, {"id": 185, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 186, "prop": "name", "attributes": {"content": "一切你都記得，一切你都關心，幾百年的人、事、物，畢竟都如江水東流，唯獨朔還是朔。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 187, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#4$2"}}, {"id": 188, "prop": "name", "attributes": {"content": "但不是誰都能像你一樣……", "name": "望"}, "figure_art": "avg_2027_wang_1#4$2"}, {"id": 189, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 190, "prop": "name", "attributes": {"content": "你想讓夕花多長時間變得像你一樣？餘呢？迫使餘變得和你一樣，真的是好事嗎？", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 191, "prop": "name", "attributes": {"content": "一千年已經太短，而我們甚至沒有一千年可以揮霍。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 192, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#11$2"}}, {"id": 193, "prop": "name", "attributes": {"content": "我們沒有更多時間了。", "name": "望"}, "figure_art": "avg_2027_wang_1#11$2"}, {"id": 194, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 195, "prop": "name", "attributes": {"content": "棋道上我不如你，但我也知道，即便一時看不見制勝奇招，堂堂正正的本手，也好過激進的無理手。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 196, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#11$2"}}, {"id": 197, "prop": "name", "attributes": {"content": "所以大哥是覺得這局棋已經下不贏了？因為下不贏了，只要姿態堂堂正正，哪怕輸了也問心無愧？", "name": "望"}, "figure_art": "avg_2027_wang_1#11$2"}, {"id": 198, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 199, "prop": "name", "attributes": {"content": "我何曾這麼說過……", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 200, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#11$2"}}, {"id": 201, "prop": "name", "attributes": {"content": "依你的計策，到頭來不會有別的結果。", "name": "望"}, "figure_art": "avg_2027_wang_1#11$2"}, {"id": 202, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 203, "prop": "name", "attributes": {"content": "……那你說，我們該怎麼辦？", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 204, "prop": "name", "attributes": {"content": "若你真計算出了一條行得通的路，那就告訴我，我情願與你同去，勝算還大一點。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 205, "prop": "name", "attributes": {"content": "只要你告訴我，你究竟有幾成勝算。我可以任你差遣，哪怕要我的命我也絕無怨言。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 206, "prop": "name", "attributes": {"content": "……但你知道自己在做什麼嗎？", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 207, "prop": "name", "attributes": {"content": "你是不是心裡只裝著自己的勝負，完全不顧風險，也不曾想過會招致什麼樣的後果？", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 208, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 209, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 210, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 211, "prop": "name", "attributes": {"content": "告訴我。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 212, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 213, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 214, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#8$1"}}, {"id": 215, "prop": "name", "attributes": {"content": "說話。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#8$1"}, {"id": 216, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#10$2"}}, {"id": 217, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#10$2"}, {"id": 218, "prop": "dialog", "attributes": {}}, {"id": 219, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 0.5, "block": "true"}}, {"id": 220, "prop": "Image", "attributes": {"image": "70_i02_1", "screenadapt": "coverall", "fadetime": 0.0, "y": 180.0, "xScale": 1.2, "yScale": 1.2, "x": 60.0}}, {"id": 221, "prop": "charslot", "attributes": {}}, {"id": 222, "prop": "background", "attributes": {}}, {"id": 223, "prop": "curtain", "attributes": {"direction": 0.0, "fillfrom": 0.1, "fillto": 0.4, "fadetime": 0.01}}, {"id": 224, "prop": "curtain", "attributes": {"direction": 4.0, "fillfrom": 0.1, "fillto": 0.2, "fadetime": 0.01}}, {"id": 225, "prop": "playsound", "attributes": {"key": "$d_avg_slamstonetable"}}, {"id": 226, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 1.0, "block": "false"}}, {"id": 227, "prop": "CameraShake", "attributes": {"duration": 0.3, "xstrength": 30.0, "ystrength": 30.0, "vibrato": 30.0, "randomness": 90.0, "fadeout": "true", "block": "false"}}, {"id": 228, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 229, "prop": "name", "attributes": {"content": "你究竟想沒想過？！", "name": "朔"}}, {"id": 230, "prop": "dialog", "attributes": {}}, {"id": 231, "prop": "name", "attributes": {"content": "情難自抑的代理人猛地一拍石桌——他原本是這麼想的。"}}, {"id": 232, "prop": "name", "attributes": {"content": "但他畢竟還沒完全適應這具人的身體，這一掌不光拍得太重，還拍錯了位置。"}}, {"id": 233, "prop": "name", "attributes": {"content": "那方望一直隨身帶著的棋枰上，霎時出現了一道一寸見深的裂紋。"}}, {"id": 234, "prop": "dialog", "attributes": {}}, {"id": 235, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 1.5, "block": "true"}}, {"id": 236, "prop": "Image", "attributes": {"image": "70_i02_1", "screenadapt": "coverall", "fadetime": 0.0}}, {"id": 237, "prop": "charslot", "attributes": {}}, {"id": 238, "prop": "curtain", "attributes": {}}, {"id": 239, "prop": "delay", "attributes": {"time": 0.25}}, {"id": 240, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 1.5, "block": "true"}}, {"id": 241, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 242, "prop": "name", "attributes": {"content": "……", "name": "望"}}, {"id": 243, "prop": "name", "attributes": {"content": "望，我——", "name": "朔"}}, {"id": 244, "prop": "name", "attributes": {"content": "兄長自己鑄就的這具“人”的軀體，依然有開碑裂石之能，著實令人佩服。", "name": "望"}}, {"id": 245, "prop": "name", "attributes": {"content": "……你聽我說！", "name": "朔"}}, {"id": 246, "prop": "name", "attributes": {"content": "免了。", "name": "望"}}, {"id": 247, "prop": "name", "attributes": {"content": "我們當中誰都比不上兄長境界之高，我們的死活，也不勞兄長擔心了。", "name": "望"}}, {"id": 248, "prop": "dialog", "attributes": {}}, {"id": 249, "prop": "PlaySound", "attributes": {"key": "$d_avg_clothmovement", "volume": 1.0}}, {"id": 250, "prop": "Image", "attributes": {"image": "70_i02_2", "screenadapt": "coverall", "fadetime": 1.0}}, {"id": 251, "prop": "delay", "attributes": {"time": 1.5}}, {"id": 252, "prop": "name", "attributes": {"content": "望！", "name": "朔"}}, {"id": 253, "prop": "Dialog", "attributes": {}}, {"id": 254, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 255, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 256, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 3.0, "block": "true"}}, {"id": 257, "prop": "charslot", "attributes": {}}, {"id": 258, "prop": "image", "attributes": {}}, {"id": 259, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 260, "prop": "Background", "attributes": {"image": "70_g13_oldyanstreet", "screenadapt": "coverall"}}, {"id": 261, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 262, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 263, "prop": "playsound", "attributes": {"key": "$d_avg_footstep_stonestep", "loop": "true", "channel": "bgs"}}, {"id": 264, "prop": "StopSound", "attributes": {"channel": "bgs", "fadetime": 2.0}}, {"id": 265, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#4$2", "duration": 1.0}}, {"id": 266, "prop": "delay", "attributes": {"time": 2.0}}, {"id": 267, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#8$1", "duration": 1.0}}, {"id": 268, "prop": "delay", "attributes": {"time": 2.0}}, {"id": 269, "prop": "playMusic", "attributes": {"key": "$m_sys_act23side_loop", "volume": 0.6}}, {"id": 270, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2", "focus": "l"}}, {"id": 271, "prop": "name", "attributes": {"content": "……你怎麼來了？", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 272, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#8$1", "focus": "r"}}, {"id": 273, "prop": "name", "attributes": {"content": "一臉怨懟。和大哥吵架了？", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 274, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2", "focus": "l"}}, {"id": 275, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 276, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#9$1", "focus": "r"}}, {"id": 277, "prop": "name", "attributes": {"content": "果然。我不過在路上淺醉片刻，你們就能鬧出事來。", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 278, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#10$2", "focus": "l"}}, {"id": 279, "prop": "name", "attributes": {"content": "你有什麼事要和他說，自己去便是。", "name": "望"}, "figure_art": "avg_2027_wang_1#10$2"}, {"id": 280, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#9$1", "focus": "r"}}, {"id": 281, "prop": "name", "attributes": {"content": "這又是何苦呢？", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 282, "prop": "name", "attributes": {"content": "我知道你和他會為了什麼吵——除歲，對吧。", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 283, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#10$2", "focus": "l"}}, {"id": 284, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#10$2"}, {"id": 285, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#1$1", "focus": "r"}}, {"id": 286, "prop": "name", "attributes": {"content": "但你們也不是第一次因為這件事起爭執了，求同存異，怎麼就做不到？", "name": "令"}, "figure_art": "avg_2023_ling_1#1$1"}, {"id": 287, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2", "focus": "l"}}, {"id": 288, "prop": "name", "attributes": {"content": "事關生死，不是一句求同存異就能帶過去的事。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 289, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#1$1", "focus": "r"}}, {"id": 290, "prop": "name", "attributes": {"content": "難道真到大難當頭那一刻，你們還能兄弟鬩牆？", "name": "令"}, "figure_art": "avg_2023_ling_1#1$1"}, {"id": 291, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#4$2", "focus": "l"}}, {"id": 292, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#4$2"}, {"id": 293, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#1$1", "focus": "r"}}, {"id": 294, "prop": "name", "attributes": {"content": "別在該把話說清楚的時候躲著。拖得久了，小事也拖成了疙瘩。", "name": "令"}, "figure_art": "avg_2023_ling_1#1$1"}, {"id": 295, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#4$2", "focus": "l"}}, {"id": 296, "prop": "name", "attributes": {"content": "今天還是免了。", "name": "望"}, "figure_art": "avg_2027_wang_1#4$2"}, {"id": 297, "prop": "dialog", "attributes": {}}, {"id": 298, "prop": "charslot", "attributes": {"slot": "l", "afrom": 1.0, "ato": 0.0, "duration": 1.5}}, {"id": 299, "prop": "playsound", "attributes": {"key": "$d_avg_footstep_stonestep", "loop": "true", "channel": "bgs"}}, {"id": 300, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 301, "prop": "StopSound", "attributes": {"channel": "bgs", "fadetime": 0.5}}, {"id": 302, "prop": "delay", "attributes": {"time": 0.5}}, {"id": 303, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#3$1", "focus": "r"}}, {"id": 304, "prop": "name", "attributes": {"content": "二哥……別這樣，你先回來——", "name": "令"}, "figure_art": "avg_2023_ling_1#3$1"}, {"id": 305, "prop": "dialog", "attributes": {}}, {"id": 306, "prop": "playsound", "attributes": {"key": "$d_avg_footstep_stonestep", "loop": "true", "channel": "bgs", "volume": 0.6}}, {"id": 307, "prop": "StopSound", "attributes": {"channel": "bgs", "fadetime": 1.5}}, {"id": 308, "prop": "delay", "attributes": {"time": 1.5}}, {"id": 309, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#6$1", "focus": "r"}}, {"id": 310, "prop": "name", "attributes": {"content": "臭棋簍子！你今年到底多大？在妹妹面前耍小孩子脾氣，你不害臊？", "name": "令"}, "figure_art": "avg_2023_ling_1#6$1"}, {"id": 311, "prop": "dialog", "attributes": {}}, {"id": 312, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#11$2", "focus": "l", "duration": 0.5}}, {"id": 313, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 314, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#11$2", "focus": "l"}}, {"id": 315, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#11$2"}, {"id": 316, "prop": "Dialog", "attributes": {}}, {"id": 317, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 318, "prop": "charslot", "attributes": {}}, {"id": 319, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 320, "prop": "Background", "attributes": {"image": "70_g11_oldpavilion", "screenadapt": "coverall"}}, {"id": 321, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 322, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 323, "prop": "name", "attributes": {"content": "令在前面領頭，望慢吞吞地拖在後面。"}}, {"id": 324, "prop": "name", "attributes": {"content": "兩人都看見，最年長的代理人還在亭邊，維持著端坐的姿勢。"}}, {"id": 325, "prop": "dialog", "attributes": {}}, {"id": 326, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#8$1", "duration": 1.0}}, {"id": 327, "prop": "delay", "attributes": {"time": 1.5}}, {"id": 328, "prop": "name", "attributes": {"content": "大哥。", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 329, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#1$1"}}, {"id": 330, "prop": "name", "attributes": {"content": "令妹……", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 331, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#8$1"}}, {"id": 332, "prop": "name", "attributes": {"content": "我早說了，“令妹”聽起來倒像是在叫我的妹妹，不像在叫我，你也不改改。", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 333, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#1$1"}}, {"id": 334, "prop": "name", "attributes": {"content": "抱歉，習慣了，多少有點積習難改。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 335, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#8$1"}}, {"id": 336, "prop": "name", "attributes": {"content": "我看也是積習難改。", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 337, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#9$1"}}, {"id": 338, "prop": "name", "attributes": {"content": "嘖，這個棋枰……吵架就吵架，還動手砸東西，三歲小孩？", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 339, "prop": "dialog", "attributes": {}}, {"id": 340, "prop": "charslot", "attributes": {}}, {"id": 341, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2", "duration": 1.0}}, {"id": 342, "prop": "delay", "attributes": {"time": 1.5}}, {"id": 343, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 344, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#6$1"}}, {"id": 345, "prop": "name", "attributes": {"content": "……", "name": "朔"}, "figure_art": "avg_2024_chyue_1#6$1"}, {"id": 346, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#1$1"}}, {"id": 347, "prop": "name", "attributes": {"content": "過些時日，我去找塊好一點的木材，幫你做張新的。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 348, "prop": "name", "attributes": {"content": "還是說，你更喜歡現在這張棋盤？那也沒關係，等年或者易在的時候，我請他們幫忙修好，你看……？", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 349, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 350, "prop": "name", "attributes": {"content": "……不必。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 351, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#9$1"}}, {"id": 352, "prop": "name", "attributes": {"content": "唉……簡直感覺像是回到我剛踏足人間的那段日子了。三不五時就能看見你們兩個爭鬥不休。", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 353, "prop": "name", "attributes": {"content": "當時那位秉燭人還惴惴不安地問我呢……", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 354, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#3$1"}}, {"id": 355, "prop": "name", "attributes": {"content": "“等後面的弟弟妹妹全都出世，你們到底得打成什麼樣？您能不能預估一下，我得上奏朝廷，方便安排避難啊！”", "name": "令"}, "figure_art": "avg_2023_ling_1#3$1"}, {"id": 356, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#9$1"}}, {"id": 357, "prop": "name", "attributes": {"content": "……咳。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#9$1"}, {"id": 358, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#10$2"}}, {"id": 359, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#10$2"}, {"id": 360, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#8$1"}}, {"id": 361, "prop": "name", "attributes": {"content": "這樣吧，大哥今天就先回去，我自己和二哥聊聊。", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 362, "prop": "name", "attributes": {"content": "我就當一次傳話筒，省得你們在氣頭上，再吵起來不知道還要砸壞什麼東西。", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 363, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#1$1"}}, {"id": 364, "prop": "name", "attributes": {"content": "……也好。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 365, "prop": "name", "attributes": {"content": "那這個棋枰……", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 366, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 367, "prop": "name", "attributes": {"content": "……放這裡吧，我自己修。兄長不用再替這個東西操心了。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 368, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2024_chyue_1#1$1"}}, {"id": 369, "prop": "name", "attributes": {"content": "好。", "name": "朔"}, "figure_art": "avg_2024_chyue_1#1$1"}, {"id": 370, "prop": "dialog", "attributes": {}}, {"id": 371, "prop": "playsound", "attributes": {"key": "$d_gen_walk_n"}}, {"id": 372, "prop": "charslot", "attributes": {"duration": 1.5}}, {"id": 373, "prop": "delay", "attributes": {"time": 2.5}}, {"id": 374, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#8$1"}}, {"id": 375, "prop": "name", "attributes": {"content": "你還是沒消氣。", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 376, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#1$2"}}, {"id": 377, "prop": "name", "attributes": {"content": "哪有。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 378, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#8$1"}}, {"id": 379, "prop": "name", "attributes": {"content": "你心平氣和的時候，當著他的面，從來不會叫他什麼“兄長”。", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 380, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2027_wang_1#4$2"}}, {"id": 381, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#4$2"}, {"id": 382, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_2023_ling_1#8$1"}}, {"id": 383, "prop": "name", "attributes": {"content": "所以，說說吧，你們到底聊什麼了？", "name": "令"}, "figure_art": "avg_2023_ling_1#8$1"}, {"id": 384, "prop": "Dialog", "attributes": {}}, {"id": 385, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 386, "prop": "charslot", "attributes": {}}, {"id": 387, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2"}}, {"id": 388, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#7$1"}}, {"id": 389, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 390, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#7$1", "focus": "r"}}, {"id": 391, "prop": "name", "attributes": {"content": "……和我想的一點不差。", "name": "令"}, "figure_art": "avg_2023_ling_1#7$1"}, {"id": 392, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#9$1", "focus": "r"}}, {"id": 393, "prop": "name", "attributes": {"content": "他的方法堂堂正正，但要說快慢，那自然是慢的。要是哪天祂突然甦醒，一切就都來不及了。", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 394, "prop": "name", "attributes": {"content": "至於你……唉。", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 395, "prop": "name", "attributes": {"content": "不過你要是真的想這麼頂撞他，自己總該有個良策，才好跟他大呼小叫吧？", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 396, "prop": "name", "attributes": {"content": "他為了替我們自證清白，連最重要的劍都借出去了，你當真一點也不領情？", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 397, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2", "focus": "l"}}, {"id": 398, "prop": "name", "attributes": {"content": "……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 399, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#9$1", "focus": "r"}}, {"id": 400, "prop": "name", "attributes": {"content": "你該不會真的在氣他砸壞了你的棋盤？", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 401, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2", "focus": "l"}}, {"id": 402, "prop": "name", "attributes": {"content": "何至於……", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 403, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#3$2", "focus": "l"}}, {"id": 404, "prop": "name", "attributes": {"content": "只是看他不緊不慢的，令人惱火。", "name": "望"}, "figure_art": "avg_2027_wang_1#3$2"}, {"id": 405, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#9$1", "focus": "r"}}, {"id": 406, "prop": "name", "attributes": {"content": "兄弟姐妹，哪個不是在找一條能走通的路？小夕不是更加沒主意，你看她難道也要生氣不成？", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 407, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#4$2", "focus": "l"}}, {"id": 408, "prop": "name", "attributes": {"content": "那倒也……不至於。", "name": "望"}, "figure_art": "avg_2027_wang_1#4$2"}, {"id": 409, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#1$1", "focus": "r"}}, {"id": 410, "prop": "name", "attributes": {"content": "祂的甦醒的確正在加速，大家心裡都著急，一時說錯了話，起了爭執，都是情有可原。", "name": "令"}, "figure_art": "avg_2023_ling_1#1$1"}, {"id": 411, "prop": "name", "attributes": {"content": "但祂的醒來至少也要以百年為尺度，若是和大炎鬧翻了，搞出亂子就是朝夕之間的事了。", "name": "令"}, "figure_art": "avg_2023_ling_1#1$1"}, {"id": 412, "prop": "dialog", "attributes": {}}, {"id": 413, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 414, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#9$1", "focus": "r"}}, {"id": 415, "prop": "name", "attributes": {"content": "怎麼，也嫌我慢性子了？那就儘管說。", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 416, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_2027_wang_1#1$2", "focus": "l"}}, {"id": 417, "prop": "name", "attributes": {"content": "……並無此意。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 418, "prop": "name", "attributes": {"content": "你剛剛說，我們都在找一條路。", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 419, "prop": "name", "attributes": {"content": "你在找的，是什麼？", "name": "望"}, "figure_art": "avg_2027_wang_1#1$2"}, {"id": 420, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#9$1", "focus": "r"}}, {"id": 421, "prop": "name", "attributes": {"content": "你耳朵還真靈。", "name": "令"}, "figure_art": "avg_2023_ling_1#9$1"}, {"id": 422, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#7$1", "focus": "r"}}, {"id": 423, "prop": "name", "attributes": {"content": "說到底，祂也好，我也罷，無非是大夢一場罷了。", "name": "令"}, "figure_art": "avg_2023_ling_1#7$1"}, {"id": 424, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_2023_ling_1#1$1", "focus": "r"}}, {"id": 425, "prop": "name", "attributes": {"content": "事先說好，這只是個極不完整的想法，我自己也不知道究竟能做到哪一分。", "name": "令"}, "figure_art": "avg_2023_ling_1#1$1"}, {"id": 426, "prop": "name", "attributes": {"content": "但我的確想……留下一個夢。", "name": "令"}, "figure_art": "avg_2023_ling_1#1$1"}, {"id": 427, "prop": "name", "attributes": {"content": "一個哪怕祂徹底甦醒也沒辦法驚擾的夢。", "name": "令"}, "figure_art": "avg_2023_ling_1#1$1"}, {"id": 428, "prop": "Dialog", "attributes": {}}, {"id": 429, "prop": "delay", "attributes": {"time": 2.0}}, {"id": 430, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 431, "prop": "bgeffect", "attributes": {}}, {"id": 432, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 433, "prop": "hidecgitem", "attributes": {}}, {"id": 434, "prop": "Image", "attributes": {}}, {"id": 435, "prop": "charslot", "attributes": {}}, {"id": 436, "prop": "name", "attributes": {"content": ""}}], "OPTIONTRACE": true}