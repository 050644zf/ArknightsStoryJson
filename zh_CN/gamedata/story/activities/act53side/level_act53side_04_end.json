 "block": "true"}}, {"id": 135, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 136, "prop": "name", "attributes": {"content": "0030呼叫总部，0030呼叫总部......", "name": "太阳谷维修员"}}, {"id": 137, "prop": "Dialog", "attributes": {}}, {"id": 138, "prop": "PlaySound", "attributes": {"key": "$transmission", "volume": 1.0}}, {"id": 139, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 140, "prop": "name", "attributes": {"content": "糟了，我......", "name": "太阳谷维修员"}}, {"id": 141, "prop": "name", "attributes": {"content": "我该怎么办......", "name": "太阳谷维修员"}}, {"id": 142, "prop": "Dialog", "attributes": {}}, {"id": 143, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 0.0, "block": "true"}}, {"id": 144, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 145, "prop": "charslot", "attributes": {}}, {"id": 146, "prop": "curtain", "attributes": {}}, {"id": 147, "prop": "focusout", "attributes": {"duration": 0.1, "type": "bg", "from": 1.0, "to": 0.0, "block": "true"}}, {"id": 148, "prop": "Background", "attributes": {"image": "76_g5_sunvalleycom", "screenadapt": "coverall"}}, {"id": 149, "prop": "Delay", "attributes": {"time": 2.0}}, {"id": 150, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 151, "prop": "Delay", "attributes": {"time": 1.0}}, {"id": 152, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_1015_aglna2_1#1$2"}}, {"id": 153, "prop": "name", "attributes": {"content": "喂喂，塔妮？五分钟到了，你现在怎么样？", "name": "安洁莉娜"}, "figure_art": "avg_1015_aglna2_1#1$2"}, {"id": 154, "prop": "Dialog", "attributes": {}}, {"id": 155, "prop": "PlaySound", "attributes": {"key": "$transmission", "volume": 1.0}}, {"id": 156, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 157, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_1015_aglna2_1#2$2"}}, {"id": 158, "prop": "name", "attributes": {"content": "塔妮？塔妮？能听到我说话吗？", "name": "安洁莉娜"}, "figure_art": "avg_1015_aglna2_1#2$2"}, {"id": 159, "prop": "Dialog", "attributes": {}}, {"id": 160, "prop": "PlaySound", "attributes": {"key": "$transmission", "volume": 1.0}}, {"id": 161, "prop": "delay", "attributes": {"time": 1.0}}, {"id": 162, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_1015_aglna2_1#17$2"}}, {"id": 163, "prop": "name", "attributes": {"content": "坏了——！", "name": "安洁莉娜"}, "figure_art": "avg_1015_aglna2_1#17$2"}, {"id": 164, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 165, "prop": "Dialog", "attributes": {}}, {"id": 166, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 0.0, "block": "true"}}, {"id": 167, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 168, "prop": "charslot", "attributes": {}}, {"id": 169, "prop": "Background", "attributes": {"image": "bg_offce", "screenadapt": "coverall"}}, {"id": 170, "prop": "Delay", "attributes": {"time": 2.0}}, {"id": 171, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 172, "prop": "Delay", "attributes": {"time": 1.0}}, {"id": 173, "prop": "playMusic", "attributes": {"intro": "$sjoyasorrow_intro", "key": "$sjoyasorrow_loop", "volume": 0.6}}, {"id": 174, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#7$1"}}, {"id": 175, "prop": "name", "attributes": {"content": "先先先生您看，这一大包都是我的通讯核心，您看我把它们保护得多好，这些真的都是我接下来一路维修要用的！", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#7$1"}, {"id": 176, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#8$1"}}, {"id": 177, "prop": "name", "attributes": {"content": "您也是通讯塔的负责人，肯定能看出来这些东西不是我拿来骗人的，我......我真的是来维修信号塔的工程师！", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#8$1"}, {"id": 178, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 179, "prop": "name", "attributes": {"content": "我说了，这些无法证明您的身份。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 180, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#12$1"}}, {"id": 181, "prop": "name", "attributes": {"content": "（小声）不行不行不行绝对不能在这里就停下我要不直接去按他们的火警警报然后趁他们慌乱的时候偷溜进去？", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#12$1"}, {"id": 182, "prop": "name", "attributes": {"content": "（小声）没错这样我偷跑进去一定就能争取到维修的机会——", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#12$1"}, {"id": 183, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2363_1#8$1"}}, {"id": 184, "prop": "name", "attributes": {"content": "（小声）别胡闹！现在重要的是身份！你身上到底有没有什么东西可以证明身份？", "name": "太阳谷联络员"}, "figure_art": "avg_npc_2363_1#8$1"}, {"id": 185, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#7$1"}}, {"id": 186, "prop": "name", "attributes": {"content": "（小声）我真的只有这些......", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#7$1"}, {"id": 187, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2363_1#8$1"}}, {"id": 188, "prop": "name", "attributes": {"content": "（小声）那现在连我都要起疑了！你们到底——", "name": "太阳谷联络员"}, "figure_art": "avg_npc_2363_1#8$1"}, {"id": 189, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#10$1"}}, {"id": 190, "prop": "name", "attributes": {"content": "对了！巴顿先生！", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#10$1"}, {"id": 191, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 192, "prop": "name", "attributes": {"content": "怎么了？", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 193, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#10$1"}}, {"id": 194, "prop": "name", "attributes": {"content": "我叫嘉辛塔·坎贝尔，我在太阳谷也有股份——我可以以我的股东身份担保，让阿梅利亚来维修通讯塔吗？", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#10$1"}, {"id": 195, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 196, "prop": "name", "attributes": {"content": "......身份欺诈是很严重的犯罪，小姐。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 197, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#9$1"}}, {"id": 198, "prop": "name", "attributes": {"content": "我知道我的股份在太阳谷不算什么，但米娅和利亚姆·坎贝尔难道您也没听说过？", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#9$1"}, {"id": 199, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 200, "prop": "name", "attributes": {"content": "恰恰相反，他们太有名了，每个想招摇撞骗的人都试图和他们扯上关系。我们可不知道自己有个叫嘉辛塔的股东。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 201, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#11$1"}}, {"id": 202, "prop": "name", "attributes": {"content": "不、不知道吗？", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#11$1"}, {"id": 203, "prop": "Dialog", "attributes": {}}, {"id": 204, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_npc_2363_1#5$1", "posfrom": "250,0", "posto": "100,0", "duration": 0.8}}, {"id": 205, "prop": "Delay", "attributes": {"time": 1.0}}, {"id": 206, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_npc_2363_1#5$1", "focus": "r"}}, {"id": 207, "prop": "name", "attributes": {"content": "（小声）既然打算骗人就装得强硬一点啊！突然软了下来就没气势了！", "name": "太阳谷联络员"}, "figure_art": "avg_npc_2363_1#5$1"}, {"id": 208, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#10$1", "focus": "m"}}, {"id": 209, "prop": "name", "attributes": {"content": "不，我没在骗人！", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#10$1"}, {"id": 210, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#7$1", "focus": "m"}}, {"id": 211, "prop": "name", "attributes": {"content": "您可以去股东名册里找！我的名字一定在那里面！", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#7$1"}, {"id": 212, "prop": "Dialog", "attributes": {}}, {"id": 213, "prop": "charslot", "attributes": {}}, {"id": 214, "prop": "name", "attributes": {"content": "负责人狐疑地看着嘉辛塔，但眼前这个小姑娘实在过于郑重其事了。"}}, {"id": 215, "prop": "Dialog", "attributes": {}}, {"id": 216, "prop": "PlaySound", "attributes": {"key": "$d_avg_paper1"}}, {"id": 217, "prop": "Delay", "attributes": {"time": 1.0}}, {"id": 218, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 219, "prop": "name", "attributes": {"content": "唔，还真的有。嘉辛塔·坎贝尔，照片看起来还是个小朋友，但......她长大了的确应该是你的样子。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 220, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#9$1"}}, {"id": 221, "prop": "name", "attributes": {"content": "呼......", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#9$1"}, {"id": 222, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#10$1"}}, {"id": 223, "prop": "name", "attributes": {"content": "我在如释重负个什么劲啊，真是的......算了，巴顿先生，这样是不是可以让阿梅利亚去修塔了？", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#10$1"}, {"id": 224, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 225, "prop": "name", "attributes": {"content": "......这件事我得和其他人商量一下。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 226, "prop": "name", "attributes": {"content": "不管怎么说，我对刚刚的轻慢感到抱歉。二位可以在矿区住一段时间，等我们得出结论再行动。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 227, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#10$1"}}, {"id": 228, "prop": "name", "attributes": {"content": "住一段时间？得出结论要这么久吗？", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#10$1"}, {"id": 229, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 230, "prop": "name", "attributes": {"content": "因为这同样涉及我们在大铁屯和纵贯红土公司交涉的部分，现在远程通讯中断，信使来往需要时间。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 231, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#5$1"}}, {"id": 232, "prop": "name", "attributes": {"content": "这就难办了，和我们同行的安洁莉娜小姐——", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#5$1"}, {"id": 233, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#8$1"}}, {"id": 234, "prop": "name", "attributes": {"content": "绝绝绝绝绝绝对不行！我们现在就去修塔好不好，嘉辛塔——巴顿先生！", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#8$1"}, {"id": 235, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#6$1"}}, {"id": 236, "prop": "name", "attributes": {"content": "呃......这、这么急吗？", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#6$1"}, {"id": 237, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#1$1"}}, {"id": 238, "prop": "name", "attributes": {"content": "真的很急——而且安洁莉娜也很急啊！", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#1$1"}, {"id": 239, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 240, "prop": "name", "attributes": {"content": "可现在最急的好像是你啊。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 241, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#5$1"}}, {"id": 242, "prop": "name", "attributes": {"content": "我......", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#5$1"}, {"id": 243, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#14$1"}}, {"id": 244, "prop": "name", "attributes": {"content": "我确实很急，我没法不急——我其实是背着公司跑出来的啊！", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#14$1"}, {"id": 245, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 246, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#6$1"}}, {"id": 247, "prop": "name", "attributes": {"content": "欸？！", "name": "嘉辛塔"}, "figure_art": "avg_4237_jcinta_1#6$1"}, {"id": 248, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#1$1"}}, {"id": 249, "prop": "name", "attributes": {"content": "我......我之前一直没跟你们讲，怕你们——", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#1$1"}, {"id": 250, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#16$1"}}, {"id": 251, "prop": "name", "attributes": {"content": "替我担心——", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#16$1"}, {"id": 252, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#6$1"}}, {"id": 253, "prop": "name", "attributes": {"content": "——其实纵贯红土公司的工程总监本来也不是现场技术人员，而是研发人员，所以我没有工程师的证明！", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#6$1"}, {"id": 254, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 255, "prop": "name", "attributes": {"content": "研发人员的证明你总该有吧？", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 256, "prop": "Dialog", "attributes": {}}, {"id": 257, "prop": "charslot", "attributes": {}}, {"id": 258, "prop": "playMusic", "attributes": {"key": "$victorianormal_loop", "volume": 0.6}}, {"id": 259, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_4236_tmslot_1#5$1"}}, {"id": 260, "prop": "name", "attributes": {"content": "在、在这里！这是我的工牌，名字和工号都在上面！", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#5$1"}, {"id": 261, "prop": "Dialog", "attributes": {}}, {"id": 262, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_npc_2363_1#4$1", "posfrom": "150,0", "posto": "0,0", "duration": 0.8}}, {"id": 263, "prop": "Delay", "attributes": {"time": 1.0}}, {"id": 264, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_npc_2363_1#4$1", "focus": "r"}}, {"id": 265, "prop": "name", "attributes": {"content": "（小声）......你刚刚不是说只有那些工具能证明身份吗？那现在这个算什么？", "name": "太阳谷联络员"}, "figure_art": "avg_npc_2363_1#4$1"}, {"id": 266, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_4236_tmslot_1#1$1", "focus": "l"}}, {"id": 267, "prop": "name", "attributes": {"content": "（小声）非......非常抱歉！刚刚我一急，说有袋鼷兽把纸质文件偷走了，又拿出一个不完全匹配的工牌，我怕会......", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#1$1"}, {"id": 268, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_npc_2363_1#3$1", "focus": "r"}}, {"id": 269, "prop": "name", "attributes": {"content": "（小声）你这家伙急中生智的本领倒是不差......等塔修完，有没有兴趣跟我去萨尔贡做生意？", "name": "太阳谷联络员"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 270, "prop": "charslot", "attributes": {"slot": "l", "name": "avg_4236_tmslot_1#3$1", "focus": "l"}}, {"id": 271, "prop": "name", "attributes": {"content": "（小声）萨、萨尔贡？联络员先生您别打岔，我快要乱套了啊啊啊......", "name": "阿梅利亚"}, "figure_art": "avg_4236_tmslot_1#3$1"}, {"id": 272, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_npc_2363_1#3$1", "focus": "r"}}, {"id": 273, "prop": "name", "attributes": {"content": "（小声）好好好。", "name": "太阳谷联络员"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 274, "prop": "Dialog", "attributes": {}}, {"id": 275, "prop": "charslot", "attributes": {"slot": "r", "name": "avg_npc_2363_1#3$1", "posfrom": "0,0", "posto": "80,0", "afrom": 1.0, "ato": 0.0, "duration": 0.8}}, {"id": 276, "prop": "Delay", "attributes": {"time": 1.0}}, {"id": 277, "prop": "charslot", "attributes": {}}, {"id": 278, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 279, "prop": "name", "attributes": {"content": "和来安装的那些人的工牌倒确实是一套，颜色也不一样......看着倒是那么回事。不过你们公司的工牌都不写职位的？", "name": "严肃的负责人"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 280, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#12$1"}}, {"id": 281, "prop": "name", "attributes": {"content": "公司、公司推崇扁平化管理，所以......", "name": "阿梅利亚"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 282, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 283, "prop": "name", "attributes": {"content": "行吧。所以这一切到底是怎么回事，阿梅利亚小姐？", "name": "严肃的负责人"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 284, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#1$1"}}, {"id": 285, "prop": "name", "attributes": {"content": "我......我，负责了远程通讯系统的研发，顺利投入运营，可上面还是觉得收支不平衡，希望能进一步削减开支！", "name": "阿梅利亚"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 286, "prop": "name", "attributes": {"content": "所以我又迭代了全自动的二代系统！可、可我的同事......呃，阿什顿先生，他工作实在太粗心了！", "name": "阿梅利亚"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 287, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#17$1"}}, {"id": 288, "prop": "name", "attributes": {"content": "他提交给我的数据中有不少错误，测试也不好好跑，大家又都着急，二代系统就风风火火地上了线......", "name": "阿梅利亚"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 289, "prop": "name", "attributes": {"content": "结果导致了大断连，公司非要我负责不可，又是赔偿又是担责，可这明明就不是我的错呀！", "name": "阿梅利亚"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 290, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 291, "prop": "name", "attributes": {"content": "纵贯红土公司......哥伦比亚起家的企业果然多多少少都有点这方面的问题。我们雷姆必拓的企业从来不做这种事。", "name": "严肃的负责人"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 292, "prop": "name", "attributes": {"content": "可你这么私自跑出来，不等于还是在为公司善后吗？", "name": "严肃的负责人"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 293, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#1$1"}}, {"id": 294, "prop": "name", "attributes": {"content": "这......", "name": "阿梅利亚"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 295, "prop": "name", "attributes": {"content": "......他们把断连期间的赔偿和各种责任都算在我头上，早点修好，我也少被他们讹点钱......", "name": "阿梅利亚"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 296, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#14$1"}}, {"id": 297, "prop": "name", "attributes": {"content": "而且我、我做这些也不全是为了公司！我其实一直有个理想——", "name": "阿梅利亚"}, "figure_art": "avg_npc_2363_1#3$1"}, {"id": 298, "prop": "Dialog", "attributes": {}}, {"id": 299, "prop": "charslot", "attributes": {}}, {"id": 300, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 301, "prop": "PlaySound", "attributes": {"key": "$rungeneral"}}, {"id": 302, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_1015_aglna2_1#17$2", "duration": 1.0, "block": "true"}}, {"id": 303, "prop": "Delay", "attributes": {"time": 1.2}}, {"id": 304, "prop": "name", "attributes": {"content": "嘉辛塔、阿梅利亚？你们怎么还在这里？", "name": "安洁莉娜"}, "figure_art": "avg_1015_aglna2_1#17$2"}, {"id": 305, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_npc_2353_1#1$1"}}, {"id": 306, "prop": "name", "attributes": {"content": "这位是......罗德岛的干员？我是这里的负责人巴顿，出什么事了？", "name": "严肃的负责人"}, "figure_art": "avg_npc_2353_1#1$1"}, {"id": 307, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_1015_aglna2_1#17$2"}}, {"id": 308, "prop": "name", "attributes": {"content": "巴顿先生，井下出了问题，你们的一位员工，还有我们的朋友塔妮，都被困在巷道里了！", "name": "安洁莉娜"}, "figure_art": "avg_1015_aglna2_1#17$2"}, {"id": 309, "prop": "dialog", "attributes": {}}, {"id": 310, "prop": "Blocker", "attributes": {"a": 0.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 0.0, "block": "true"}}, {"id": 311, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 312, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 313, "prop": "charslot", "attributes": {}}, {"id": 314, "prop": "Background", "attributes": {}}, {"id": 315, "prop": "Image", "attributes": {}}], "OPTIONTRACE": true}