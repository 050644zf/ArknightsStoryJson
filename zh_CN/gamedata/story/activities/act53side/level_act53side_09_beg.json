atter", "layer": 1.0, "x": 70.0, "y": 120.0}}, {"id": 451, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4235_thumpy_1#11$2"}}, {"id": 452, "prop": "name", "attributes": {"content": "我的喷雾罐！", "name": "塔妮"}, "figure_art": "avg_npc_2349_1#1$6"}, {"id": 453, "prop": "effect", "attributes": {"name": "$e_emoji_question", "layer": 1.0, "x": 70.0, "y": 200.0}}, {"id": 454, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4237_jcinta_1#6$1"}}, {"id": 455, "prop": "name", "attributes": {"content": "这......这这这，阿梅利亚，你刚刚是不是还有话要对我说？要不你现在说说看？", "name": "嘉辛塔"}, "figure_art": "avg_npc_2349_1#1$6"}, {"id": 456, "prop": "effect", "attributes": {"name": "$e_emoji_sweat02", "layer": 1.0, "x": 30.0, "y": 120.0}}, {"id": 457, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4236_tmslot_1#3$1"}}, {"id": 458, "prop": "name", "attributes": {"content": "这种时候怎么可能想得起来啦啊啊啊——", "name": "阿梅利亚"}, "figure_art": "avg_npc_2349_1#1$6"}, {"id": 459, "prop": "charslot", "attributes": {"slot": "m", "name": "avg_4235_thumpy_1#12$4"}}, {"id": 460, "prop": "name", "attributes": {"content": "难道传说是真的，它们真要把我们的话全偷走吗？！", "name": "塔妮"}, "figure_art": "avg_npc_2349_1#1$6"}, {"id": 461, "prop": "Dialog", "attributes": {}}, {"id": 462, "prop": "charslot", "attributes": {"duration": 1.0}}, {"id": 463, "prop": "delay", "attributes": {"time": 2.0}}, {"id": 464, "prop": "bgeffect", "attributes": {"name": "$eb_sunshine_upperedge", "layer": 2.0, "x": 300.0, "y": 300.0, "xto": 100.0, "yto": 100.0, "movetime": 5.0}}, {"id": 465, "prop": "focusout", "attributes": {"duration": 2.0, "type": "bg", "from": 0.0, "to": 0.5}}, {"id": 466, "prop": "delay", "attributes": {"time": 2.0}}, {"id": 467, "prop": "name", "attributes": {"content": "“怎么可能啊！”"}}, {"id": 468, "prop": "name", "attributes": {"content": "一边在心里这样否认，一边又为此惴惴不安。"}}, {"id": 469, "prop": "name", "attributes": {"content": "行至大地尽头的她们举起手里称得上武器的东西，准备夺回那些还未讲完的故事。"}}, {"id": 470, "prop": "Dialog", "attributes": {}}, {"id": 471, "prop": "delay", "attributes": {"time": 2.0}}, {"id": 472, "prop": "Blocker", "attributes": {"a": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "fadetime": 2.0, "block": "true"}}, {"id": 473, "prop": "bgeffect", "attributes": {}}, {"id": 474, "prop": "stopmusic", "attributes": {"fadetime": 2.0}}, {"id": 475, "prop": "hidecgitem", "attributes": {}}, {"id": 476, "prop": "Image", "attributes": {}}, {"id": 477, "prop": "charslot", "attributes": {}}], "OPTIONTRACE": true}